# ---- API (apps/api) -------------------------------------------------------
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
# OAuth callbacks go through the web proxy so session cookies are sent with them.
API_PUBLIC_URL=http://localhost:3000/api

# Runtime role (row level security applies). Migrations use the owner URL.
DATABASE_URL=postgres://aiwork_app:aiwork_app_dev@localhost:5432/aiworkhub
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/aiworkhub

# 32 random bytes, base64. Dev default is insecure on purpose; the API refuses to start in
# production with it. In production, replace the local key wrapper with AWS KMS (docs/SECURITY.md).
#   openssl rand -base64 32
MASTER_KEY=
MASTER_KEY_ID=dev-1
SESSION_TTL_HOURS=12

# Development sign-in (demo users from `npm run seed`). Must be false in production.
DEV_AUTH=true

# ---- AI -------------------------------------------------------------------
# auto = Claude when ANTHROPIC_API_KEY is set, otherwise the free built-in local engine.
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Integrations (OAuth apps you register with each provider) -------------
# Google Cloud console: OAuth client (Web). Redirect URI: ${API_PUBLIC_URL}/integrations/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: OAuth App. Callback URL: ${API_PUBLIC_URL}/integrations/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Web (apps/web) -------------------------------------------------------
API_INTERNAL_URL=http://localhost:4000
