# Copy to .env on the server. Generate secrets with the commands shown.

# Public address users type in the browser. https://your.domain, or http://<vm-ip> for a test.
PUBLIC_URL=https://work.example.com
# Hostname for automatic HTTPS (DNS A record must point at the VM). Use :80 for IP-only testing.
DOMAIN=work.example.com

POSTGRES_PASSWORD=       # openssl rand -hex 24
APP_DB_PASSWORD=         # openssl rand -hex 24   (hex only, it goes into a URL)
MASTER_KEY=              # openssl rand -base64 32

# Site password (Caddy basic auth). Hash: docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# Caddy reads the hash from the environment. Escape every $ as $$ if you put it in this file.
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH=

# Demo mode: DEV_AUTH=true needs NODE_ENV=development. SSO is not built yet, so keep the Caddy password on.
NODE_ENV=development
DEV_AUTH=true

# Optional. Leave empty to use the free built-in AI engine.
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
